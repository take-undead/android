<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 権限は最小限（CLAUDE.md B1）。VPN の口（BIND_VPN_SERVICE）は WireGuard ライブラリ側の manifest が宣言する -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false: WireGuard の秘密鍵を持つため、端末のバックアップに乗せない（CLAUDE.md G13） -->
    <application
        android:name=".Mt5App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- 【注意】android:screenOrientation は付けない（縦固定するとタブレット対応時に全画面を直す羽目になる。lint がエラーにする） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- config.txt を「開く」「共有」で受け取る（ファイル選択画面を使わない道。RAM の少ない端末はファイル選択画面を
                 開くとこのアプリが OS に止められるため。受け取った中身は config.txt として読めたときだけ保存する） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
